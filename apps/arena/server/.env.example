# AI Arena — anahtarlar SADECE bu dosyada durur (bu dosyanın adını .env yap).
# .env dosyası .gitignore'da; GitHub'a gitmez. Tarayıcıya hiç gönderilmez.

OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Modeller (istersen değiştir)
OPENAI_MODEL=gpt-6.1-sol
GEMINI_MODEL=gemini-3.1-pro-preview
ANTHROPIC_MODEL=claude-sonnet-5-5

# İsteğe bağlı: ayarlarsan arena sayfasına da aynı değeri girmen gerekir
ARENA_TOKEN=

# Sınırlar
MAX_OUTPUT_TOKENS=1400
MAX_CONCURRENT=4
PORT=8787
# Sunucuyu kullanabilecek sayfalar (virgülle)
ALLOW_ORIGINS=https://batulekesiz28-dot.github.io,http://localhost:8766,http://127.0.0.1:8766,null
