{
  "manifest_version": 3,
  "name": "AppShell · siteler hub içinde",
  "version": "1.3",
  "description": "YouTube, YouTube Music, WhatsApp Web ve Bambu Lab MakerWorld'ün SADECE AppShell hub'ı içinde açılmasına izin verir ve çalan şarkıyı hub'ın üst adasında gösterir. Başka hiçbir siteye dokunmaz.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://music.youtube.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://web.whatsapp.com/*",
    "https://makerworld.com/*",
    "https://bambulab.com/*"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "gom",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://batulekesiz28-dot.github.io/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "isaret.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://music.youtube.com/*",
        "https://www.youtube.com/*"
      ],
      "js": [
        "calar.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}