{
  "manifest_version": 3,
  "name": "AppShell · YouTube Music hub içinde",
  "version": "1.0",
  "description": "YouTube Music'in SADECE AppShell hub'ı içinde açılmasına izin verir. Başka hiçbir siteye dokunmaz.",
  "permissions": ["declarativeNetRequest"],
  "host_permissions": ["https://music.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [{ "id": "gom", "enabled": true, "path": "rules.json" }]
  },
  "content_scripts": [{
    "matches": ["https://batulekesiz28-dot.github.io/*", "http://localhost/*", "http://127.0.0.1/*"],
    "js": ["isaret.js"],
    "run_at": "document_start",
    "all_frames": false
  }]
}
